# Copy to .env and fill in. Never commit .env.

# Exchange API keys: only needed for `vtrade live`.
# Create keys with trading permission only (NO withdrawal permission) and IP-restrict them.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Some exchanges (OKX, KuCoin, Coinbase) also need a passphrase.
EXCHANGE_API_PASSWORD=

# Claude trade reviewer: only needed when llm.enabled is true in config.yaml.
ANTHROPIC_API_KEY=
